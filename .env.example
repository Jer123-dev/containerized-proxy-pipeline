# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Rename this file to .env and populate your actual values before running build.
# ==============================================================================

# THE PROXY LAYER CONFIG
PROXY_USER=your_proxy_username_here
PROXY_PASSWORD=your_proxy_password_here
PROXY_IP=your_proxy_ip_address_here
PROXY_PORT=your_proxy_port_here

# THE EDGE NODES TOKENS
TRAFFMONETIZER_TOKEN=your_traffmonetizer_token_here
REPOCKET_EMAIL=your_email@domain.com
REPOCKET_API_KEY=your_repocket_api_key_here
PACKETSTREAM_CID=your_packetstream_cid_here
GAGANODE_TOKEN=your_gaganode_token_here
